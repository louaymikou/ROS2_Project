    <!-- ArUco Markers along the track -->
    <!-- ArUco 0 - at the very start (HOME) -->
    <model name="aruco_0">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.002 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 0.15 0.001</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://aruco_0/materials/scripts</uri>
              <uri>model://aruco_0/materials/textures</uri>
              <name>aruco_0</name>
            </script>
          </material>
        </visual>
