<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mon_robot">
  
  <!-- Import the original robot xacro -->
  <xacro:include filename="$(find my_robot_controller)/description/robot.urdf.xacro" />
  
  <!-- Override the gazebo_ros2_control plugin with namespace -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>my_robot_state_publisher</robot_param_node>
      <parameters>$(find my_robot_controller)/config/my_controllers.yaml</parameters>
      <ros>
        <namespace>/my_bot</namespace>
      </ros>
    </plugin>
  </gazebo>
  
</robot>
