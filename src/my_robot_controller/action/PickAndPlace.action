# Goal - Define the pickup and dropoff locations
float32 pickup_x
float32 pickup_y
float32 dropoff_x
float32 dropoff_y
---
# Result - Indicate if the mission was successful
bool success
string message
---
# Feedback - Provide progress updates
string current_state  # e.g., "navigating_to_pickup", "picking", "navigating_to_dropoff", "dropping"
float32 progress      # percentage 0.0 to 1.0
