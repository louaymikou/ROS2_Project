<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Une source de lumière -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Garder le ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- On charge votre map -->
    <model name="my_blender_map">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <!-- Use package path that works in Docker -->
              <uri>file:///ros2_ws/install/my_robot_controller/share/my_robot_controller/models/my_map.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///ros2_ws/install/my_robot_controller/share/my_robot_controller/models/my_map.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== MURS POUR SLAM ========== -->
    
    <!-- Mur NORD (en haut) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur SUD (en bas) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur EST (à droite) -->
    <model name="wall_east">
      <static>true</static>
      <pose>8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur OUEST (à gauche) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Central (pour rendre la carte intéressante) -->
    <model name="obstacle_center">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2 2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>2 2 1</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== CUBE POUR PICK & PLACE ========== -->
    <model name="cube_object">
      <pose>0 5.5 0.15 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0042</ixx>
            <iyy>0.0042</iyy>
            <izz>0.0042</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.2 0.2 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 0.2 0.2</size></box>
          </geometry>
          <material>
            <ambient>1 0.2 0.2 1.0</ambient>
            <diffuse>1 0.2 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Second pickup cube (green) -->
    <model name="cube_green">
      <pose>-3 4 0.15 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0042</ixx>
            <iyy>0.0042</iyy>
            <izz>0.0042</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.2 0.2 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 0.2 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1.0</ambient>
            <diffuse>0.2 0.8 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Third pickup cube (yellow) -->
    <model name="cube_yellow">
      <pose>4 3 0.15 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0042</ixx>
            <iyy>0.0042</iyy>
            <izz>0.0042</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.2 0.2 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 0.2 0.2</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.9 0.1 1.0</ambient>
            <diffuse>1.0 0.9 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== ADDITIONAL OBSTACLES ========== -->
    
    <!-- Cylindrical pillar -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-4 -3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>1.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>1.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.6 1</ambient>
            <diffuse>0.6 0.6 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- L-shaped obstacle -->
    <model name="l_obstacle">
      <static>true</static>
      <pose>-2 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>3 0.3 1</size></box>
          </geometry>
        </collision>
        <collision name="collision_2">
          <pose>-1.35 0.85 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>3 0.3 1</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="visual_2">
          <pose>-1.35 0.85 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 2 1</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drop-off table -->
    <model name="drop_table">
      <static>true</static>
      <pose>5 -4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 1 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 1 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small ramp obstacle -->
    <model name="ramp">
      <static>true</static>
      <pose>2 5 0 0 0 0.785</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.15 0.3 0 0</pose>
          <geometry>
            <box><size>1.5 2 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.15 0.3 0 0</pose>
          <geometry>
            <box><size>1.5 2 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
