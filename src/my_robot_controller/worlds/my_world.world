    </model>

    <!-- NIVEAU 3 - Tablette haute (1.8m) -->
    <model name="shelf_level_3">
      <static>true</static>
      <pose>5.5 -4 1.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
