    <model name="shelf_label_1_1">
      <static>true</static>
      <pose>5.95 -2.5 0.6 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.02 0.8 0.15</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.7 0.3 1</ambient>
            <diffuse>0.4 0.8 0.4 1</diffuse>
