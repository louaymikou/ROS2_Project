<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Une source de lumière -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Garder le ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- On charge votre map -->
    <model name="my_blender_map">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <!-- Use package path that works in Docker -->
              <uri>file:///ros2_ws/install/my_robot_controller/share/my_robot_controller/models/my_map.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///ros2_ws/install/my_robot_controller/share/my_robot_controller/models/my_map.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== MURS POUR SLAM ========== -->
    
    <!-- Mur NORD (en haut) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur SUD (en bas) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.2 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur EST (à droite) -->
    <model name="wall_east">
      <static>true</static>
      <pose>8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur OUEST (à gauche) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 16 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== PACKAGES POUR PICK & PLACE ========== -->
    
    <!-- Petit Package (Bleu) - 0.3x0.3x0.3m -->

    <!-- Petit Package (Bleu) #2 -->

    <!-- Grand Package (Orange) - 0.5x0.4x0.6m -->
    <model name="large_package_1">
      <pose>0 5.5 0.3 0 0 0</pose>
      <link name="package_link">
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.038</ixx>
            <iyy>0.043</iyy>
            <izz>0.021</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.4 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.4 0.6</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.5 0.1 1.0</ambient>
            <diffuse>1.0 0.6 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grand Package (Orange) #2 -->
    <model name="large_package_2">
      <pose>2 5 0.3 0 0 0</pose>
      <link name="package_link">
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.038</ixx>
            <iyy>0.043</iyy>
            <izz>0.021</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.4 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.4 0.6</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.5 0.1 1.0</ambient>
            <diffuse>1.0 0.6 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========== ÉTAGÈRE DE STOCKAGE AVEC CASIERS ========== -->
    
    <!-- Structure principale de l'étagère -->
    <model name="storage_shelf_back">
      <static>true</static>
      <pose>6 -4 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 3.0 2.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 3.0 2.4</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Poteaux verticaux gauche -->
    <model name="storage_shelf_post_left">
      <static>true</static>
      <pose>6 -5.5 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 0.1 2.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 0.1 2.4</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.15 1</ambient>
            <diffuse>0.4 0.35 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Poteaux verticaux droit -->
    <model name="storage_shelf_post_right">
      <static>true</static>
      <pose>6 -2.5 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 0.1 2.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 0.1 2.4</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.15 1</ambient>
            <diffuse>0.4 0.35 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- NIVEAU 1 - Tablette basse (0.6m) -->
    <model name="shelf_level_1">
      <static>true</static>
      <pose>5.5 -4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 3.0 0.03</size></box>
