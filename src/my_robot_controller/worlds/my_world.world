            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Séparateurs verticaux pour créer des casiers -->
    <!-- Séparateur 1 (entre casiers gauche et centre) -->
    <model name="shelf_divider_1">
      <static>true</static>
      <pose>5.5 -3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.9 0.03 2.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.9 0.03 2.4</size></box>
          </geometry>
          <material>
            <ambient>0.45 0.35 0.25 1</ambient>
            <diffuse>0.55 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Séparateur 2 (entre casiers centre et droit) -->
    <model name="shelf_divider_2">
      <static>true</static>
      <pose>5.5 -5 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
