          <material>
            <ambient>0.5 0.4 0.3 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- NIVEAU 2 - Tablette moyenne (1.2m) -->
    <model name="shelf_level_2">
      <static>true</static>
      <pose>5.5 -4 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 3.0 0.03</size></box>
